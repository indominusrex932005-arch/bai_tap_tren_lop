<%
    // price / salePrice là tên trường trong model Mongo (sanphamModel.js)
    const price = Number(product.price ?? product.unit_price ?? 0);
    const promotion = Number(product.salePrice ?? product.promotion_price ?? 0);
    const onSale = promotion > 0 && promotion < price;
    const money = value => Number(value).toLocaleString('vi-VN') + 'đ';
    const image = product.image
        ? (product.image.startsWith('/') || /^https?:\/\//i.test(product.image)
            ? product.image : '/image/product/' + encodeURIComponent(product.image))
        : '/assets/dest/images/products/1.jpg';
%>
<div class="col-sm-3">
    <div class="single-item">
        <% if (onSale || product.tag) { %>
        <div class="ribbon-wrapper"><div class="ribbon sale"><%= onSale ? 'Sale' : product.tag %></div></div>
        <% } %>
        <div class="single-item-header">
            <a href="#"><img src="<%= image %>" alt="<%= product.name %>" loading="lazy"
                onerror="this.onerror=null;this.src='/assets/dest/images/products/1.jpg'"></a>
        </div>
        <div class="single-item-body">
            <p class="single-item-title"><%= product.name %></p>
            <p class="single-item-price">
                <% if (onSale) { %>
                <span class="flash-del"><%= money(price) %></span>
                <span class="flash-sale"><%= money(promotion) %></span>
                <% } else { %>
                <span><%= money(price) %></span>
                <% } %>
            </p>
        </div>
        <div class="single-item-caption">
            <a class="add-to-cart pull-left" href="#" title="Thêm vào giỏ"><i class="fa fa-shopping-cart"></i></a>
            <a class="beta-btn primary" href="#">Mua ngay <i class="fa fa-chevron-right"></i></a>
            <div class="clearfix"></div>
        </div>
    </div>
</div>

<div class="col-sm-3">
	<div class="single-item">
		<% if (product.tag) { %>
		<div class="ribbon-wrapper"><div class="ribbon sale"><%= product.tag %></div></div>
		<% } %>
		<div class="single-item-header">
			<a href="#"><img src="/image/product/<%= product.image %>" alt="<%= product.name %>"></a>
		</div>
		<div class="single-item-body">
			<p class="single-item-title"><%= product.name %></p>
			<p class="single-item-price">
				<% if (product.salePrice) { %>
				<span class="flash-del"><%= product.price.toLocaleString('vi-VN') %>đ</span>
				<span class="flash-sale"><%= product.salePrice.toLocaleString('vi-VN') %>đ</span>
				<% } else { %>
				<span><%= product.price.toLocaleString('vi-VN') %>đ</span>
				<% } %>
			</p>
		</div>
		<div class="single-item-caption">
			<a class="add-to-cart pull-left" href="#"><i class="fa fa-shopping-cart"></i></a>
			<a class="beta-btn primary" href="#">Mua ngay <i class="fa fa-chevron-right"></i></a>
			<div class="clearfix"></div>
		</div>
	</div>
</div>

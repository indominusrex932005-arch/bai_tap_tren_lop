<section class="beta-products-list" aria-labelledby="new-products-title">
    <h4 id="new-products-title">Sản phẩm mới</h4>
    <div class="beta-products-details">
        <p class="pull-left"><%= products.length %> sản phẩm</p>
        <div class="clearfix"></div>
    </div>
    <% if (products.length === 0) { %>
        <p class="empty-products">Chưa có sản phẩm mới.</p>
    <% } %>
    <% for (var i = 0; i < products.length; i += 4) { %>
    <div class="row">
        <% products.slice(i, i + 4).forEach(function (product) { %>
        <%- include('product-card', { product }) %>
        <% }) %>
    </div>
    <% if (i + 4 < products.length) { %><div class="space40">&nbsp;</div><% } %>
    <% } %>
</section>
